@using LoopFlow.Models
@model ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center align-items-center my-4">
    <div class="col-md-6 col-lg-5">
        <div class="glass-card p-4 p-md-5 shadow-lg border-0 rounded-4">

            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning bg-opacity-10 p-3 mb-3">
                    <i class="bi bi-key-fill text-warning fs-2"></i>
                </div>
                <h3 class="fw-bold text-white mb-1">Change Your Password</h3>
                <p class="text-muted small">Your account requires a mandatory password update before accessing your portal.</p>
            </div>

            @if (TempData["Warning"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show text-xs p-3 mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Warning"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { role = "form", @class = "needs-validation" }))
            {
                @Html.AntiForgeryToken()

                if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger p-3 mb-4 rounded-3" role="alert">
                        <i class="bi bi-x-circle-fill me-2"></i>
                        @Html.ValidationSummary(true, "", new { @class = "text-danger m-0" })
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">Current / Temporary Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-lock"></i></span>
                        @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control bg-dark text-white border-secondary", placeholder = "Enter current password", required = "required" })
                    </div>
                    @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-key"></i></span>
                        @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control bg-dark text-white border-secondary", placeholder = "Minimum 6 characters", required = "required", minlength = "6" })
                    </div>
                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small fw-semibold">Confirm New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-shield-check"></i></span>
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control bg-dark text-white border-secondary", placeholder = "Re-enter new password", required = "required" })
                    </div>
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                </div>

                <button type="submit" class="btn btn-loop w-100 py-2.5 fs-6 fw-bold">
                    <i class="bi bi-check-circle me-2"></i> Update Password & Continue
                </button>
            }

        </div>
    </div>
</div>

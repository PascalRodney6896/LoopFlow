@using LoopFlow.Models
@model LoginViewModel
@{
    ViewBag.Title = "Centralized Sign In";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center align-items-center my-4">
    <div class="col-md-6 col-lg-5">
        <div class="glass-card p-4 p-md-5 shadow-lg border-0 rounded-4">
            
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10 p-3 mb-3">
                    <i class="bi bi-shield-lock-fill text-danger fs-2"></i>
                </div>
                <h3 class="fw-bold text-white mb-1">LOOP FLOW Sign In</h3>
                <p class="text-muted small">Centralized Authentication & Role-Based Portal Access</p>
            </div>

            @if (TempData["Warning"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show text-xs p-3 mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Warning"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form", @class = "needs-validation" }))
            {
                @Html.AntiForgeryToken()
                
                if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger p-3 mb-4 rounded-3" role="alert">
                        <i class="bi bi-x-circle-fill me-2"></i>
                        @Html.ValidationSummary(true, "", new { @class = "text-danger m-0" })
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">Username or Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-person"></i></span>
                        @Html.TextBoxFor(m => m.UsernameOrEmail, new { @class = "form-control bg-dark text-white border-secondary", placeholder = "admin, wanjiku, or admin@loopflow.com", required = "required", autofocus = "autofocus" })
                    </div>
                    @Html.ValidationMessageFor(m => m.UsernameOrEmail, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label text-muted small fw-semibold mb-0">Password</label>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-key"></i></span>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control bg-dark text-white border-secondary", placeholder = "••••••••", required = "required" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input bg-dark border-secondary" })
                        <label class="form-check-label text-muted small" for="RememberMe">
                            Remember me
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-loop w-100 py-2.5 fs-6 fw-bold">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Sign In to Portal
                </button>
            }

            <div class="mt-4 pt-3 border-top border-secondary border-opacity-25">
                <p class="text-center text-muted text-xs mb-2 fw-semibold">Demo Credentials Quick Select:</p>
                <div class="d-flex flex-wrap gap-1.5 justify-content-center">
                    <button class="btn btn-sm btn-outline-danger text-xs px-2 py-1" onclick="fillCreds('admin', 'Admin@12345')">Admin</button>
                    <button class="btn btn-sm btn-outline-info text-xs px-2 py-1" onclick="fillCreds('wanjiku', 'Password123!')">Merchant</button>
                    <button class="btn btn-sm btn-outline-success text-xs px-2 py-1" onclick="fillCreds('kenyaseed', 'Password123!')">Supplier</button>
                    <button class="btn btn-sm btn-outline-warning text-xs px-2 py-1" onclick="fillCreds('underwriter', 'Password123!')">Financier</button>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    function fillCreds(user, pass) {
        document.getElementById('UsernameOrEmail').value = user;
        document.getElementById('Password').value = pass;
    }
</script>
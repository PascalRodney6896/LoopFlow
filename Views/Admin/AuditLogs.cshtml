@model System.Collections.Generic.List<LoopFlow.Models.AuditLog>
@{
    ViewBag.Title = "System Audit Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-3">

    <!-- Header Banner -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary border-opacity-25">
        <div>
            <h2 class="fw-bold text-white mb-1"><i class="bi bi-shield-check text-info me-2"></i> Security Audit Logs</h2>
            <p class="text-muted small mb-0">Immutable record of authentication, privilege changes, and administrative security events</p>
        </div>
        <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Dashboard</a>
    </div>

    <!-- Search & Action Filters -->
    <div class="glass-card p-3 mb-4">
        @using (Html.BeginForm("AuditLogs", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
        {
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control bg-dark text-white border-secondary text-xs" placeholder="Search description, IP address, user name..." value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-md-5">
                <select name="actionFilter" class="form-select bg-dark text-white border-secondary text-xs">
                    <option value="">-- All Security Actions --</option>
                    <option value="Successful Login" selected="@(ViewBag.ActionFilter == "Successful Login")">Successful Login</option>
                    <option value="Failed Login" selected="@(ViewBag.ActionFilter == "Failed Login")">Failed Login</option>
                    <option value="User Locked" selected="@(ViewBag.ActionFilter == "User Locked")">User Locked</option>
                    <option value="User Unlocked" selected="@(ViewBag.ActionFilter == "User Unlocked")">User Unlocked</option>
                    <option value="User Activated" selected="@(ViewBag.ActionFilter == "User Activated")">User Activated</option>
                    <option value="User Deactivated" selected="@(ViewBag.ActionFilter == "User Deactivated")">User Deactivated</option>
                    <option value="User Created" selected="@(ViewBag.ActionFilter == "User Created")">User Created</option>
                    <option value="User Updated" selected="@(ViewBag.ActionFilter == "User Updated")">User Updated</option>
                    <option value="Password Reset" selected="@(ViewBag.ActionFilter == "Password Reset")">Password Reset</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-info btn-sm w-100"><i class="bi bi-filter"></i> Apply Filter</button>
            </div>
        }
    </div>

    <!-- Audit Logs Table -->
    <div class="glass-card p-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle text-xs mb-0">
                <thead>
                    <tr class="text-muted">
                        <th>#</th>
                        <th>Timestamp (UTC)</th>
                        <th>User / Initiator</th>
                        <th>Action Type</th>
                        <th>Entity</th>
                        <th>Description / Activity</th>
                        <th>IP Address</th>
                        <th>Result</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var log in Model)
                        {
                            var badgeClass = log.ActionType.Contains("Failed") || log.ActionType.Contains("Locked") ? "bg-danger" : log.ActionType.Contains("Created") || log.ActionType.Contains("Successful") ? "bg-success" : "bg-info";

                            <tr>
                                <td class="text-muted">@log.Id</td>
                                <td class="fw-semibold">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>
                                    <div class="fw-bold text-white">@(log.User != null ? log.User.FullName : "Anonymous / System")</div>
                                    <div class="text-muted text-xs">@(log.User != null ? log.User.Email : "")</div>
                                </td>
                                <td>
                                    <span class="badge @badgeClass px-2 py-1">@log.ActionType</span>
                                </td>
                                <td>
                                    <span class="text-muted">@log.EntityType @(log.EntityId.HasValue ? $"#{log.EntityId}" : "")</span>
                                </td>
                                <td>
                                    <div class="text-white">@log.OldValue</div>
                                    @if (!string.IsNullOrEmpty(log.ErrorMessage))
                                    {
                                        <div class="text-danger small mt-0.5"><i class="bi bi-exclamation-triangle me-1"></i> @log.ErrorMessage</div>
                                    }
                                </td>
                                <td><code>@log.IpAddress</code></td>
                                <td>
                                    @if (log.Success)
                                    {
                                        <span class="badge bg-success bg-opacity-20 text-success"><i class="bi bi-check-circle me-1"></i> Pass</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-20 text-danger"><i class="bi bi-x-circle me-1"></i> Fail</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No audit logs found matching criteria.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model LoopFlow.Models.User
@{
    ViewBag.Title = "Edit User Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var roles = ViewBag.Roles as System.Collections.Generic.List<LoopFlow.Models.Role> ?? new System.Collections.Generic.List<LoopFlow.Models.Role>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="glass-card p-4 p-md-5">

                <div class="d-flex align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                    <a href="@Url.Action("Users", "Admin")" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Back</a>
                    <div>
                        <h3 class="fw-bold text-white mb-0"><i class="bi bi-pencil-square text-info me-2"></i> Edit User Account</h3>
                        <p class="text-muted small mb-0">Update account details, role permissions, or security status for @Model.FullName</p>
                    </div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger p-3 mb-4" role="alert">
                        @Html.ValidationSummary(true, "", new { @class = "m-0" })
                    </div>
                }

                @using (Html.BeginForm("EditUser", "Admin", new { id = Model.Id }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-semibold">Full Name *</label>
                            <input type="text" name="fullName" class="form-control bg-dark text-white border-secondary" value="@Model.FullName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-semibold">Username</label>
                            <input type="text" name="username" class="form-control bg-dark text-white border-secondary" value="@(Model.Username ?? Model.Email)" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-semibold">Email Address *</label>
                            <input type="email" name="email" class="form-control bg-dark text-white border-secondary" value="@Model.Email" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-semibold">Phone Number</label>
                            <input type="text" name="phoneNumber" class="form-control bg-dark text-white border-secondary" value="@Model.PhoneNumber" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-semibold">Business Name</label>
                            <input type="text" name="businessName" class="form-control bg-dark text-white border-secondary" value="@Model.BusinessName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-semibold">Assigned System Role *</label>
                            <select name="roleId" class="form-select bg-dark text-white border-secondary" required>
                                @foreach (var r in roles)
                                {
                                    <option value="@r.Id" selected="@(Model.RoleId == r.Id || Model.Role == r.Name)">@r.Name - @r.Description</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <div class="card bg-dark border-secondary p-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="isActive" value="true" id="isActive" @(Model.IsActive ? "checked" : "") />
                                    <input type="hidden" name="isActive" value="false" />
                                    <label class="form-check-label fw-bold text-white ms-2" for="isActive">Account Active</label>
                                </div>
                                <span class="text-muted text-xs mt-1">Inactive accounts are blocked from logging in.</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card bg-dark border-secondary p-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="isLocked" value="true" id="isLocked" @(Model.IsLocked ? "checked" : "") />
                                    <input type="hidden" name="isLocked" value="false" />
                                    <label class="form-check-label fw-bold text-danger ms-2" for="isLocked">Account Locked</label>
                                </div>
                                <span class="text-muted text-xs mt-1">Locked after repeated failed login attempts. Unchecking resets failure counter.</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-25">
                        <a href="@Url.Action("Users", "Admin")" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-loop btn-lg"><i class="bi bi-check-circle me-1"></i> Save Changes</button>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

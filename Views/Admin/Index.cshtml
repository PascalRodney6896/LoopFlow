@{
    ViewBag.Title = "Admin Control Center";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var recentLogs = ViewBag.RecentLogs as System.Collections.Generic.List<LoopFlow.Models.AuditLog> ?? new System.Collections.Generic.List<LoopFlow.Models.AuditLog>();
}

<div class="container-fluid py-3">
    <!-- Header Banner -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-25">
        <div>
            <h2 class="fw-bold text-white mb-1"><i class="bi bi-shield-lock text-danger me-2"></i> System Administration</h2>
            <p class="text-muted small mb-0">Centralized User Management, Security Audit Trails & Role-Based Access Control</p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-sm-0">
            <a href="@Url.Action("CreateUser", "Admin")" class="btn btn-loop"><i class="bi bi-person-plus me-1"></i> Create New User</a>
            <a href="@Url.Action("Users", "Admin")" class="btn btn-outline-light"><i class="bi bi-people me-1"></i> Manage Users</a>
        </div>
    </div>

    <!-- Summary Metrics Grid -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="glass-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Total Users</span>
                    <div class="rounded-circle bg-primary bg-opacity-20 p-2 text-primary"><i class="bi bi-people-fill"></i></div>
                </div>
                <h3 class="fw-bold text-white mb-0">@ViewBag.TotalUsers</h3>
                <span class="text-xs text-muted">All System Accounts</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Active Users</span>
                    <div class="rounded-circle bg-success bg-opacity-20 p-2 text-success"><i class="bi bi-check-circle-fill"></i></div>
                </div>
                <h3 class="fw-bold text-success mb-0">@ViewBag.ActiveUsers</h3>
                <span class="text-xs text-muted">Normal Active Access</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Inactive Users</span>
                    <div class="rounded-circle bg-secondary bg-opacity-20 p-2 text-muted"><i class="bi bi-dash-circle-fill"></i></div>
                </div>
                <h3 class="fw-bold text-muted mb-0">@ViewBag.InactiveUsers</h3>
                <span class="text-xs text-muted">Deactivated Accounts</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="glass-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Locked Accounts</span>
                    <div class="rounded-circle bg-danger bg-opacity-20 p-2 text-danger"><i class="bi bi-lock-fill"></i></div>
                </div>
                <h3 class="fw-bold text-danger mb-0">@ViewBag.LockedUsers</h3>
                <span class="text-xs text-danger">Locked (Failed Logins)</span>
            </div>
        </div>
    </div>

    <!-- Role Breakdown Grid -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="glass-card p-3 border-start border-danger border-4">
                <span class="text-muted small">Admins</span>
                <h4 class="fw-bold text-white mt-1 mb-0">@ViewBag.TotalAdmins</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-card p-3 border-start border-info border-4">
                <span class="text-muted small">Merchants</span>
                <h4 class="fw-bold text-info mt-1 mb-0">@ViewBag.TotalMerchants</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-card p-3 border-start border-warning border-4">
                <span class="text-muted small">Financiers</span>
                <h4 class="fw-bold text-warning mt-1 mb-0">@ViewBag.TotalFinanciers</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-card p-3 border-start border-success border-4">
                <span class="text-muted small">Suppliers</span>
                <h4 class="fw-bold text-success mt-1 mb-0">@ViewBag.TotalSuppliers</h4>
            </div>
        </div>
    </div>

    <!-- Recent Security Audit Activity -->
    <div class="glass-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-white mb-0"><i class="bi bi-shield-check text-info me-2"></i> Recent Security Audit Events</h5>
            <a href="@Url.Action("AuditLogs", "Admin")" class="btn btn-sm btn-outline-info">View Full Audit Log</a>
        </div>
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle text-xs">
                <thead>
                    <tr class="text-muted">
                        <th>Timestamp</th>
                        <th>User / Initiator</th>
                        <th>Action</th>
                        <th>Target / Description</th>
                        <th>IP Address</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (recentLogs.Any())
                    {
                        foreach (var log in recentLogs)
                        {
                            <tr>
                                <td>@log.Timestamp.ToString("g")</td>
                                <td class="fw-semibold">@(log.User != null ? log.User.FullName : "System")</td>
                                <td>
                                    <span class="badge bg-dark border border-secondary text-info">@log.ActionType</span>
                                </td>
                                <td>@log.OldValue</td>
                                <td><code class="text-muted">@log.IpAddress</code></td>
                                <td>
                                    @if (log.Success)
                                    {
                                        <span class="badge bg-success bg-opacity-20 text-success"><i class="bi bi-check me-1"></i> Success</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-20 text-danger"><i class="bi bi-x me-1"></i> Failed</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-3">No recent audit logs recorded.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

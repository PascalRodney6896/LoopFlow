@model System.Collections.Generic.List<LoopFlow.Models.User>
@{
    ViewBag.Title = "User Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var roles = ViewBag.Roles as System.Collections.Generic.List<LoopFlow.Models.Role> ?? new System.Collections.Generic.List<LoopFlow.Models.Role>();
}

<div class="container-fluid py-3">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show text-xs p-3 mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show text-xs p-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header & Action Controls -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary border-opacity-25">
        <div>
            <h2 class="fw-bold text-white mb-1"><i class="bi bi-people text-info me-2"></i> User Accounts Management</h2>
            <p class="text-muted small mb-0">View, create, edit, activate/deactivate, lock/unlock, or reset user passwords</p>
        </div>
        <a href="@Url.Action("CreateUser", "Admin")" class="btn btn-loop"><i class="bi bi-person-plus me-1"></i> Add New User</a>
    </div>

    <!-- Search & Filter Controls Card -->
    <div class="glass-card p-3 mb-4">
        @using (Html.BeginForm("Users", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
        {
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control bg-dark text-white border-secondary text-xs" placeholder="Search name, email, username..." value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="roleId" class="form-select bg-dark text-white border-secondary text-xs">
                    <option value="">-- Filter by Role --</option>
                    @foreach (var r in roles)
                    {
                        <option value="@r.Id" selected="@(ViewBag.RoleId == r.Id)">@r.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="active" class="form-select bg-dark text-white border-secondary text-xs">
                    <option value="">-- All Statuses --</option>
                    <option value="true" selected="@(ViewBag.Active == true)">Active Only</option>
                    <option value="false" selected="@(ViewBag.Active == false)">Inactive Only</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="locked" class="form-select bg-dark text-white border-secondary text-xs">
                    <option value="">-- All Security --</option>
                    <option value="true" selected="@(ViewBag.Locked == true)">Locked Only</option>
                    <option value="false" selected="@(ViewBag.Locked == false)">Unlocked Only</option>
                </select>
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-info w-100"><i class="bi bi-filter"></i> Filter</button>
            </div>
        }
    </div>

    <!-- Users Table -->
    <div class="glass-card p-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle text-xs mb-0">
                <thead>
                    <tr class="text-muted">
                        <th>User Details</th>
                        <th>Username / Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Security</th>
                        <th>Last Login</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var u in Model)
                        {
                            var roleName = u.UserRole?.Name ?? u.Role ?? "Merchant";
                            var roleBadgeClass = roleName == "Admin" ? "bg-danger" : roleName == "Merchant" || roleName == "Buyer" ? "bg-info" : roleName == "Financier" ? "bg-warning text-dark" : "bg-success";

                            <tr>
                                <td>
                                    <div class="fw-bold text-white fs-6">@u.FullName</div>
                                    <div class="text-muted text-xs">@(string.IsNullOrWhiteSpace(u.BusinessName) ? "Personal Account" : u.BusinessName)</div>
                                </td>
                                <td>
                                    <div class="text-white"><i class="bi bi-person me-1 text-muted"></i> @(string.IsNullOrWhiteSpace(u.Username) ? u.Email : u.Username)</div>
                                    <div class="text-muted"><i class="bi bi-envelope me-1"></i> @u.Email</div>
                                </td>
                                <td>
                                    <span class="badge @roleBadgeClass px-2.5 py-1">@roleName</span>
                                </td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-20 text-success"><i class="bi bi-check-circle me-1"></i> Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-20 text-muted"><i class="bi bi-x-circle me-1"></i> Inactive</span>
                                    }
                                </td>
                                <td>
                                    @if (u.IsLocked)
                                    {
                                        <span class="badge bg-danger bg-opacity-20 text-danger"><i class="bi bi-lock-fill me-1"></i> Locked (@u.FailedLoginAttempts fails)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-20 text-success"><i class="bi bi-unlock-fill me-1"></i> Normal</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted">@(u.LastLoginDate.HasValue ? u.LastLoginDate.Value.ToString("g") : u.LastLoginAt.HasValue ? u.LastLoginAt.Value.ToString("g") : "Never")</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a href="@Url.Action("EditUser", "Admin", new { id = u.Id })" class="btn btn-sm btn-outline-info" title="Edit User Details"><i class="bi bi-pencil"></i></a>

                                        <!-- Toggle Active Form -->
                                        @using (Html.BeginForm("ToggleActive", "Admin", new { id = u.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            if (u.IsActive)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-warning" title="Deactivate Account" onclick="return confirm('Are you sure you want to deactivate @u.FullName?')"><i class="bi bi-person-x"></i></button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Activate Account"><i class="bi bi-person-check"></i></button>
                                            }
                                        }

                                        <!-- Toggle Lock Form -->
                                        @using (Html.BeginForm("ToggleLock", "Admin", new { id = u.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            if (u.IsLocked)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Unlock Account"><i class="bi bi-unlock"></i></button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Lock Account" onclick="return confirm('Are you sure you want to lock @u.FullName?')"><i class="bi bi-lock"></i></button>
                                            }
                                        }

                                        <!-- Reset Password Modal Trigger -->
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#resetModal-@u.Id" title="Reset Password"><i class="bi bi-key"></i></button>

                                    </div>

                                    <!-- Reset Password Modal -->
                                    <div class="modal fade text-start" id="resetModal-@u.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content bg-dark text-white border-secondary">
                                                <div class="modal-header border-secondary">
                                                    <h5 class="modal-title fw-bold"><i class="bi bi-key text-warning me-2"></i> Reset Password for @u.FullName</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                @using (Html.BeginForm("ResetPassword", "Admin", new { id = u.Id }, FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <div class="modal-body">
                                                        <p class="text-muted small">Enter a new temporary password for <strong>@u.Email</strong>. The user will be required to change it upon next login.</p>
                                                        <div class="mb-3">
                                                            <label class="form-label text-muted small fw-semibold">New Password</label>
                                                            <input type="password" name="newPassword" class="form-control bg-dark text-white border-secondary" placeholder="Minimum 6 characters" required minlength="6" />
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-secondary">
                                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-warning"><i class="bi bi-check-circle me-1"></i> Update Password</button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No users found matching your search filter.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

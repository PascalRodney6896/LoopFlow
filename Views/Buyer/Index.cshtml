@model LoopFlow.Models.Buyer
@{
    ViewBag.Title = "Merchant Portal & Wallet";
    Layout = null; // Remove the layout to exclude the navbar
    var wallet = ViewBag.Wallet as LoopFlow.Models.LoopAccount;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
    <title>LOOP FLOW</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>

    <!-- Page Wrapper -->
    <div class="buyer-dashboard-wrapper">

        <!-- Mobile Bottom Navigation -->
        <nav class="mobile-bottom-nav">
            <div class="nav-item active" data-tab="home">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z" />
                </svg>
                <span class="nav-label">Home</span>
            </div>
            <div class="nav-item" data-tab="orders">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    <path d="M9 12l2 2 4-4" />
                </svg>
                <span class="nav-label">Orders</span>
            </div>
            <div class="nav-item" data-tab="forecast">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
                </svg>
                <span class="nav-label">Merchant-Brain</span>
            </div>
            <div class="nav-item" data-tab="profile">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <span class="nav-label">Profile</span>
            </div>
        </nav>

        <!-- Main Content Area -->
        <div class="main-content-area">

            <!-- HOME TAB -->
            <div class="tab-content active" id="home-tab">

                <!-- Custom Buyer Header -->
                <div class="buyer-header">
                    <div class="buyer-header-left">
                        <div class="buyer-avatar">
                            <span>@(Model.User?.FullName?.FirstOrDefault() ?? 'W')</span>
                        </div>
                        <div class="buyer-greeting">
                            <span class="greeting-label">Welcome,</span>
                            <span class="greeting-name">@(Model.User != null ? Model.User.FullName : "Joy Wambui")</span>
                            <span class="greeting-badge">@Model.BusinessCategory</span>
                        </div>
                    </div>
                    <div class="buyer-header-right">
                        <button class="icon-btn notification-btn" aria-label="Notifications">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                            </svg>
                            <span class="notification-badge">3</span>
                        </button>
                        <button class="icon-btn settings-btn" aria-label="Settings" id="hamburgerMenu">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                <path d="M12 8v4l3 3" />
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Slide-out Hamburger Menu -->
                <div class="slide-menu" id="slideMenu">
                    <div class="slide-menu-header">
                        <div class="slide-menu-user">
                            <div class="user-avatar-lg">@(Model.User?.FullName?.FirstOrDefault() ?? 'W')</div>
                            <div class="user-info">
                                <p class="user-name-sm">@(Model.User != null ? Model.User.FullName : "Wanjiku Farmer Co-op")</p>
                                <span class="user-role">Merchant</span>
                            </div>
                        </div>
                        <button class="close-menu-btn" id="closeMenu">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                    <div class="slide-menu-items">
                        <a href="#" class="menu-item active">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z" /></svg>
                            Dashboard
                        </a>
                        <a href="#" class="menu-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v16m8-8H4" /></svg>
                            New Order
                        </a>
                        <a href="#" class="menu-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            Payment History
                        </a>
                        <a href="#" class="menu-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path d="M12 8v4l3 3" /></svg>
                            Settings
                        </a>
                        <a href="@Url.Action("Logout", "Account")" class="menu-item text-danger">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                            Logout
                        </a>
                    </div>
                </div>
                <div class="slide-overlay" id="slideOverlay"></div>

                <!-- Bank Account Card - Total Balance with Tap to Show Loop Wallet -->
                <div class="bank-account-card" id="balanceCard">
                    <div class="account-card-content">
                        <div class="account-header">
                            <span class="account-label" id="balanceLabel">Total Balance</span>
                            <span class="live-badge"></span>
                        </div>
                        <div class="account-balance" id="balanceDisplay">
                            <span class="currency-symbol">KES</span>
                            <span class="balance-amount" id="balanceAmount">@string.Format("{0:N0}", wallet != null ? wallet.WalletBalance : 142500)</span>
                            <span class="balance-decimal">.00</span>
                        </div>
                        <div class="account-details">
                            <div class="detail-item">
                                <span class="detail-label">Account Name</span>
                                <span class="detail-value">@(Model.User != null ? (!string.IsNullOrEmpty(Model.User.BusinessName) ? Model.User.BusinessName : Model.User.FullName) : "Merchant Account")</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Account Number</span>
                                <span class="detail-value">@(wallet != null ? wallet.AccountNumber : "0550123456789")</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">Bank</span>
                                <span class="detail-value">NCBA Bank</span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label">LOOP Wallet</span>
                                <span class="detail-value">@(wallet != null ? wallet.WalletNumber : "2020019988")</span>
                            </div>
                        </div>
                        <div class="tap-hint">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v1" />
                            </svg>
                            <span>Tap to view LOOP Wallet</span>
                        </div>
                    </div>
                    <div class="account-card-decoration">
                        <div class="deco-circle"></div>
                        <div class="deco-circle-2"></div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="quick-actions">
                    <button class="quick-action-btn">
                        <div class="quick-action-icon" style="background: #fce4ec; color: #dc2626;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 4v16m8-8H4" />
                            </svg>
                        </div>
                        <span class="quick-action-label">Make Payment</span>
                    </button>
                    <button class="quick-action-btn">
                        <div class="quick-action-icon" style="background: #fce4ec; color: #dc2626;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                            </svg>
                        </div>
                        <span class="quick-action-label">Withdraw</span>
                    </button>
                    <button class="quick-action-btn">
                        <div class="quick-action-icon" style="background: #fce4ec; color: #dc2626;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 4v16m8-8H4" />
                            </svg>
                        </div>
                        <span class="quick-action-label">Deposit Funds</span>
                    </button>
                </div>

                <!-- Quick Stats -->
                <div class="quick-stats-grid">
                    <div class="stat-card">
                        <span class="stat-label">Today's Sales</span>
                        <span class="stat-number">KES 47,300</span>
                        <span class="stat-change positive">+12%</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Pending Orders</span>
                        <span class="stat-number">3</span>
                        <span class="stat-change">KES 125,000</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Credit Used</span>
                        @{
                            var totalLim = Model.CreditLimit != null ? Model.CreditLimit.TotalCreditLimit : 500000.00m;
                            var usedCred = Model.CreditLimit != null ? Model.CreditLimit.UsedCredit : 0.00m;
                            var usedPct = totalLim > 0 ? (usedCred / totalLim) * 100 : 0;
                        }
                        <span class="stat-number">@usedPct.ToString("F1")%</span>
                        <span class="stat-change">@string.Format("{0:N0}", usedCred)</span>
                    </div>
                </div>

                <!-- Recent Activity -->
                <div class="recent-activity">
                    <div class="section-header">
                        <h3 class="section-title">Recent Activity</h3>
                        <button class="view-all-btn">View All</button>
                    </div>
                    <div class="activity-list">
                        <div class="activity-item">
                            <div class="activity-icon credit">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v16m8-8H4" /></svg>
                            </div>
                            <div class="activity-content">
                                <span class="activity-title">Customer Payment</span>
                                <span class="activity-time">Today, 11:45 AM</span>
                            </div>
                            <span class="activity-amount positive">+KES 4,500</span>
                        </div>
                        <div class="activity-item">
                            <div class="activity-icon debit">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12H4" /></svg>
                            </div>
                            <div class="activity-content">
                                <span class="activity-title">Jengwa Auto-deduction</span>
                                <span class="activity-time">Today, 9:00 AM</span>
                            </div>
                            <span class="activity-amount negative">-KES 1,200</span>
                        </div>
                        <div class="activity-item">
                            <div class="activity-icon debit">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12H4" /></svg>
                            </div>
                            <div class="activity-content">
                                <span class="activity-title">Supplier Payment</span>
                                <span class="activity-time">Yesterday, 4:15 PM</span>
                            </div>
                            <span class="activity-amount negative">-KES 25,000</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ORDERS TAB -->
            <div class="tab-content" id="orders-tab">
                <div class="orders-header">
                    <h2 class="orders-title">Orders & Transactions</h2>
                    <button class="new-order-btn" onclick="window.location.href='@Url.Action("CreateRequest", "Buyer")'">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 4v16m8-8H4" />
                        </svg>
                        Create Order
                    </button>
                </div>

                <!-- Credit Limit Card (Moved to Orders section) -->
                <div class="credit-card">
                    <div class="credit-header">
                        <div class="credit-title">
                            <span class="credit-label">Pre-Approved Credit Line</span>
                            <span class="credit-status active">Active</span>
                        </div>
                        <span class="credit-provider"></span>
                    </div>
                    <div class="credit-balance">
                        <span class="credit-amount">KES @string.Format("{0:N0}", Model.CreditLimit != null ? Model.CreditLimit.AvailableCredit : 350000)</span>
                        <span class="credit-available">Available</span>
                    </div>
                    <div class="credit-progress">
                        <div class="progress-track">
                            <div class="progress-fill" style="width: @usedPct%"></div>
                        </div>
                        <div class="progress-labels">
                            <span>Used: KES @string.Format("{0:N0}", usedCred)</span>
                            <span>Limit: KES @string.Format("{0:N0}", totalLim)</span>
                        </div>
                    </div>
                </div>

                <!-- Orders/Transactions Tabs -->
                <div class="sub-tabs">
                    <button class="sub-tab active" data-subtab="orders-sub">Orders</button>
                    <button class="sub-tab" data-subtab="transactions-sub">Transactions</button>
                </div>

                <!-- Orders Sub-Tab -->
                <div class="sub-tab-content active" id="orders-sub">
                    <div class="orders-filters">
                        <button class="filter-btn active" data-filter="all">All</button>
                        <button class="filter-btn" data-filter="pending">Pending</button>
                        <button class="filter-btn" data-filter="approved">Approved</button>
                        <button class="filter-btn" data-filter="funded">Funded</button>
                        <button class="filter-btn" data-filter="completed">Completed</button>
                    </div>
                    <div class="orders-table-wrapper">
                        <table class="orders-table">
                            <thead>
                                <tr>
                                    <th>Order No</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Suppliers</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var po in Model.PurchaseOrders.OrderByDescending(p => p.Id))
                                {
                                    <tr onclick="navigateToTab('orders')">
                                        <td><span class="order-number">@po.OrderNumber</span></td>
                                        <td class="order-amount">KES @string.Format("{0:N0}", po.TotalAmount)</td>
                                        <td>
                                            @if (po.Status == "Approved" || po.Status == "Funded" || po.Status == "Completed")
                                            {
                                                <span class="status-badge approved">@po.Status</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge pending">@po.Status</span>
                                            }
                                        </td>
                                        <td>
                                            @foreach (var s in po.SupplierSplits.Take(1))
                                            {
                                                <span class="supplier-count">@s.SupplierName</span>
                                                if (po.SupplierSplits.Count > 1)
                                                {
                                                    <span class="supplier-more">+@(po.SupplierSplits.Count - 1) more</span>
                                                }
                                            }
                                        </td>
                                        <td class="order-date">@po.OrderDate.ToString("dd MMM")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Transactions Sub-Tab -->
                <div class="sub-tab-content" id="transactions-sub">
                    <div class="transactions-filters">
                        <button class="filter-btn active" data-filter="all">All</button>
                        <button class="filter-btn" data-filter="topup">Top-Up</button>
                        <button class="filter-btn" data-filter="transfer">Transfer</button>
                        <button class="filter-btn" data-filter="orders">Orders</button>
                    </div>
                    <div class="transactions-list">
                        <div class="transaction-item">
                            <div class="transaction-icon credit">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v16m8-8H4" /></svg>
                            </div>
                            <div class="transaction-content">
                                <span class="transaction-title">Wallet Top-Up</span>
                                <span class="transaction-time">Today, 10:30 AM</span>
                                <span class="transaction-ref">Ref: #TXN-2026-001</span>
                            </div>
                            <span class="transaction-amount positive">+KES 50,000</span>
                        </div>
                        <div class="transaction-item">
                            <div class="transaction-icon debit">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12H4" /></svg>
                            </div>
                            <div class="transaction-content">
                                <span class="transaction-title">Supplier Payment</span>
                                <span class="transaction-time">Today, 9:15 AM</span>
                                <span class="transaction-ref">Ref: #TXN-2026-002</span>
                            </div>
                            <span class="transaction-amount negative">-KES 25,000</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- FORECAST TAB -->
            <div class="tab-content" id="forecast-tab">
                <div class="forecast-header">
                    <h2 class="forecast-title">Cash Flow Intelligence</h2>
                    <span class="forecast-period">7-Day Outlook</span>
                </div>

                <div class="forecast-features-grid">
                    <div class="forecast-feature-card">
                        <div class="feature-icon" style="background: #dbeafe; color: #2563eb;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
                            </svg>
                        </div>
                        <h4 class="feature-title">Cash Flow Forecasting</h4>
                        <p class="feature-desc">7/30/90 day predictive cash flow analysis with real-time updates</p>
                        <div class="feature-status active">Active</div>
                    </div>
                </div>
            </div>

            <!-- PROFILE TAB -->
            <div class="tab-content" id="profile-tab">
                <div class="profile-header">
                    <div class="profile-avatar-large">@(Model.User?.FullName?.FirstOrDefault() ?? 'W')</div>
                    <h2 class="profile-name">@(Model.User != null ? Model.User.FullName : "Wanjiku Farmer Co-op")</h2>
                    <span class="profile-role">Merchant</span>
                    <span class="profile-code">Code: @Model.BuyerCode</span>
                </div>
                <div class="profile-details">
                    <div class="profile-detail-item">
                        <span class="detail-label">Business Category</span>
                        <span class="detail-value">@Model.BusinessCategory</span>
                    </div>
                    <div class="profile-detail-item">
                        <span class="detail-label">Member Since</span>
                        <span class="detail-value">@Model.CreatedAt.ToString("dd MMM yyyy")</span>
                    </div>
                </div>
                <div class="profile-actions">
                    <a href="@Url.Action("Logout", "Account")" class="profile-action-btn danger">Logout</a>
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/Custom/buyer-dashboard.js"></script>

</body>
</html>

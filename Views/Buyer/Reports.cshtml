@model LoopFlow.Models.Buyer
@{
    ViewBag.Title = "Merchant Trade Statements & Reports";
    Layout = null;
    var wallet = ViewBag.Wallet as LoopFlow.Models.LoopAccount;

    var cl = Model?.CreditLimit;
    decimal totalCredit = cl?.TotalCreditLimit ?? 500000m;
    decimal usedCredit = cl?.UsedCredit ?? 0m;
    decimal availCredit = cl?.AvailableCredit ?? (totalCredit - usedCredit);
    var pos = Model?.PurchaseOrders ?? new System.Collections.Generic.List<LoopFlow.Models.PurchaseOrder>();
    var txns = Model?.LoanTransactions ?? new System.Collections.Generic.List<LoopFlow.Models.LoanTransaction>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
    <title>LOOP FLOW - Merchant Reports</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body class="bg-gray-50">

    <div class="buyer-dashboard-wrapper">
        <!-- Mobile Bottom Nav -->
        <nav class="mobile-bottom-nav">
            <div class="nav-item" onclick="window.location.href='@Url.Action("Index", "Buyer")#home'">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 01-1-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z" /></svg>
                <span class="nav-label">Home</span>
            </div>
            <div class="nav-item" onclick="window.location.href='@Url.Action("Index", "Buyer")#orders'">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /><path d="M9 12l2 2 4-4" /></svg>
                <span class="nav-label">Orders</span>
            </div>
            <div class="nav-item" onclick="window.location.href='@Url.Action("Index", "Buyer")#credit'">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10h18M7 15h1m4 0h1m-7 4h12a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                <span class="nav-label">Credit</span>
            </div>
            <div class="nav-item active" onclick="window.location.href='@Url.Action("Reports", "Buyer")'">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                <span class="nav-label">Reports</span>
            </div>
        </nav>

        <div class="main-content-area pb-5 p-3 space-y-3">
            <div class="flex items-center justify-between bg-white p-3 rounded-xl border border-gray-200 shadow-sm">
                <div>
                    <h2 class="text-base font-bold text-gray-900 my-0">Merchant Statements & Financial Reports</h2>
                    <p class="text-xs text-gray-500 my-0.5">Official trade financing, credit line statement and sales sweep repayment history</p>
                </div>
                <button onclick="window.print()" class="btn btn-sm bg-[#ff5f00] text-white text-xs px-3 py-1.5 rounded-lg font-bold">
                    <i class="bi bi-printer me-1"></i> Print Statement
                </button>
            </div>

            <!-- SME CREDIT FACILITY STATEMENT CARD -->
            <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm space-y-3">
                <div class="flex items-center justify-between border-b pb-2">
                    <h6 class="font-bold text-xs text-gray-900 my-0 uppercase">1. SME Credit Facility Statement</h6>
                    <span class="badge bg-blue-100 text-blue-800 text-[9px] font-bold">NCBA SME Facility</span>
                </div>
                <div class="grid grid-cols-3 gap-2 text-center text-xs bg-gray-50 p-3 rounded-xl">
                    <div>
                        <span class="text-[9px] text-gray-400 block uppercase">Total Line Limit</span>
                        <strong class="font-mono text-gray-900">KES @string.Format("{0:N0}", totalCredit)</strong>
                    </div>
                    <div>
                        <span class="text-[9px] text-gray-400 block uppercase">Utilised Amount</span>
                        <strong class="font-mono text-amber-700">KES @string.Format("{0:N0}", usedCredit)</strong>
                    </div>
                    <div>
                        <span class="text-[9px] text-gray-400 block uppercase">Available Credit Balance</span>
                        <strong class="font-mono text-emerald-600 font-bold">KES @string.Format("{0:N0}", availCredit)</strong>
                    </div>
                </div>
            </div>

            <!-- PURCHASE ORDERS SPEND STATEMENT -->
            <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm space-y-3">
                <div class="flex items-center justify-between border-b pb-2">
                    <h6 class="font-bold text-xs text-gray-900 my-0 uppercase">2. Purchase Orders Spend & Financing Breakdown</h6>
                    <span class="text-[10px] text-gray-500 font-mono">Total POs: @pos.Count()</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm text-xs mb-0">
                        <thead>
                            <tr class="text-gray-500">
                                <th>Order Ref</th>
                                <th>Date</th>
                                <th>Funding Path</th>
                                <th>Financing Status</th>
                                <th>Total Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var po in pos)
                            {
                                <tr>
                                    <td class="font-mono font-bold text-gray-900">@po.OrderNumber</td>
                                    <td class="text-gray-500 font-mono text-[10px]">@po.OrderDate.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge bg-light text-dark text-[9px]">@(po.FundingPath ?? "BANK_FINANCED")</span></td>
                                    <td><span class="badge bg-blue-100 text-blue-800 text-[9px]">@(po.FinancingStatus ?? "FACILITY_RESERVED")</span></td>
                                    <td class="font-mono font-bold text-gray-900">KES @string.Format("{0:N0}", po.TotalAmount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 30% AUTOMATED SALES SWEEP STATEMENT -->
            <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm space-y-3">
                <div class="flex items-center justify-between border-b pb-2">
                    <h6 class="font-bold text-xs text-gray-900 my-0 uppercase">3. Daily 30% Sales Sweep Repayments Ledger</h6>
                    <span class="badge bg-green-100 text-green-800 text-[9px] font-bold">Automated Daily Sweep</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm text-xs mb-0">
                        <thead>
                            <tr class="text-gray-500">
                                <th>Txn Ref</th>
                                <th>Timestamp</th>
                                <th>Transaction Type</th>
                                <th>Repayment Amount</th>
                                <th>Outstanding Balance After</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in txns)
                            {
                                <tr>
                                    <td class="font-mono font-bold text-gray-900">@t.TransactionReference</td>
                                    <td class="text-gray-500 font-mono text-[10px]">@t.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><span class="badge bg-green-100 text-green-800 text-[9px]">@t.TransactionType</span></td>
                                    <td class="font-mono font-bold text-green-700">KES @string.Format("{0:N0}", t.Amount)</td>
                                    <td class="font-mono font-bold text-gray-900">KES @string.Format("{0:N0}", t.BalanceAfter)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

</body>
</html>

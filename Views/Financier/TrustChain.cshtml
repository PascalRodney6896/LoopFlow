@model System.Collections.Generic.List<LoopFlow.Models.TrustChainRecord>
@{
    ViewBag.Title = "Bank TrustChain Audit Ledger";
    Layout = "~/Views/Shared/_Layout_Financier.cshtml";

    int totalBlocks = ViewBag.TotalBankBlocks ?? Model.Count;
    int facilityApprovedCount = ViewBag.FacilityApprovedCount ?? 0;
    int disbursementsHashedCount = ViewBag.DisbursementsHashedCount ?? 0;
    int sweepsHashedCount = ViewBag.SweepsHashedCount ?? 0;
}

<div class="px-4 py-3 financier-dashboard space-y-4">

    <!-- Page Header & Filter Toolbar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 bg-white p-3.5 rounded-xl border border-gray-200 shadow-sm">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-base font-bold text-gray-900 my-0">Bank Platform TrustChain Audit Ledger</h1>
                <span class="badge bg-orange-100 text-[#ff5f00] text-[10px] px-2 py-0.5 font-bold border border-orange-200">Bank Operations Only</span>
            </div>
            <p class="text-xs text-gray-500 my-0.5">Immutable SHA-256 cryptographic audit trail recording all NCBA bank underwriting approvals, drawdowns, payouts, and automated repayment sweeps.</p>
        </div>

        <!-- Filter Form -->
        @using (Html.BeginForm("TrustChain", "Financier", FormMethod.Get, new { @class = "flex items-center gap-2" }))
        {
            <select name="eventFilter" class="form-select form-select-sm text-xs w-52 rounded-lg border-gray-300">
                <option value="">All Bank Processes</option>
                <option value="FinancingApproved" @(ViewBag.EventFilter == "FinancingApproved" ? "selected" : "")>Financing Approvals</option>
                <option value="FacilityReserved" @(ViewBag.EventFilter == "FacilityReserved" ? "selected" : "")>Facility Reservations</option>
                <option value="Disbursement" @(ViewBag.EventFilter == "Disbursement" ? "selected" : "")>Supplier Disbursements</option>
                <option value="DailySweepRepayment" @(ViewBag.EventFilter == "DailySweepRepayment" ? "selected" : "")>Daily Repayment Sweeps</option>
                <option value="InvoicePostedToBank" @(ViewBag.EventFilter == "InvoicePostedToBank" ? "selected" : "")>Invoice Submissions</option>
            </select>
            <button type="submit" class="btn btn-sm bg-[#ff5f00] text-white text-xs font-bold px-3 py-1.5 rounded-lg hover:bg-orange-600 shadow-sm">
                <i class="bi bi-filter me-1"></i> Filter
            </button>
            <a href="@Url.Action("TrustChain", "Financier")" class="btn btn-sm btn-light border text-xs px-2.5 py-1.5 rounded-lg text-gray-600">
                Reset
            </a>
        }
    </div>

    <!-- BANK AUDIT STATS ROW -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div class="stat-card border-l-4 border-l-orange-500">
            <p class="stat-label">Total Bank Audit Blocks</p>
            <p class="stat-number text-[#ff5f00]">@totalBlocks</p>
            <span class="text-[9px] text-gray-400 block mt-1"><i class="bi bi-shield-check text-green-600 me-1"></i> 100% Cryptographically Intact</span>
        </div>
        <div class="stat-card border-l-4 border-l-blue-500">
            <p class="stat-label">Facility Approvals Logged</p>
            <p class="stat-number text-blue-700">@facilityApprovedCount</p>
            <span class="text-[9px] text-gray-400 block mt-1"><i class="bi bi-building me-1"></i> Underwriting Reservations</span>
        </div>
        <div class="stat-card border-l-4 border-l-green-500">
            <p class="stat-label">Disbursements Hashed</p>
            <p class="stat-number text-green-700">@disbursementsHashedCount</p>
            <span class="text-[9px] text-gray-400 block mt-1"><i class="bi bi-cash-stack me-1"></i> Supplier Payout Releases</span>
        </div>
        <div class="stat-card border-l-4 border-l-purple-500">
            <p class="stat-label">Repayment Sweeps Logged</p>
            <p class="stat-number text-purple-700">@sweepsHashedCount</p>
            <span class="text-[9px] text-gray-400 block mt-1"><i class="bi bi-arrow-repeat me-1"></i> 30% Automated Sweeps</span>
        </div>
    </div>

    <!-- BANK TRUSTCHAIN AUDIT TABLE -->
    <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
        <div class="flex items-center justify-between mb-3">
            <div>
                <h4 class="text-xs font-bold text-gray-900 uppercase tracking-wider my-0">
                    <i class="bi bi-link-45deg me-1" style="color: #ff5f00;"></i> Bank Operation Blocks & Execution Hashes
                </h4>
                <p class="text-[10px] text-gray-500 my-0">Bank platform event chain ensuring non-repudiation across core banking operations</p>
            </div>
            <span class="badge bg-green-100 text-green-800 text-[10px]"><i class="bi bi-check-all me-1"></i> Zero Tampering</span>
        </div>

        <div class="table-wrapper">
            <table class="portfolio-table text-xs">
                <thead>
                    <tr>
                        <th>Block ID</th>
                        <th>Timestamp</th>
                        <th>Bank Process Event</th>
                        <th>Order / Facility Ref</th>
                        <th>Merchant / Counterparty</th>
                        <th>Cryptographic SHA-256 Hash</th>
                        <th>Previous Hash</th>
                        <th>Audit Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var r in Model)
                        {
                            var eventBadgeClass = r.EventType == "Disbursement" ? "bg-emerald-100 text-emerald-800" :
                                                r.EventType == "DailySweepRepayment" ? "bg-lime-100 text-lime-800" :
                                                r.EventType == "FinancingApproved" ? "bg-blue-100 text-blue-800" :
                                                "bg-orange-100 text-orange-800";
                            <tr>
                                <td class="font-mono font-bold text-gray-900 py-2">#@r.Id</td>
                                <td class="text-gray-500 font-mono text-[10px]">@r.CreatedAt.ToString("dd/MM/yy HH:mm:ss")</td>
                                <td>
                                    <span class="badge @eventBadgeClass text-[9px] font-semibold">
                                        <i class="bi bi-bank me-1"></i> @r.EventType
                                    </span>
                                </td>
                                <td class="font-mono text-gray-800 font-bold">@(r.Order != null ? r.Order.OrderNumber : "FACILITY-REF")</td>
                                <td class="text-gray-700 font-semibold">@(r.Order?.Buyer?.User != null ? r.Order.Buyer.User.FullName : "Bank Customer")</td>
                                <td><code class="text-[9px] text-orange-600 font-mono" title="@r.Hash">@(r.Hash.Length > 24 ? r.Hash.Substring(0, 24) + "..." : r.Hash)</code></td>
                                <td><code class="text-[9px] text-gray-400 font-mono" title="@r.PreviousHash">@(r.PreviousHash != null && r.PreviousHash.Length > 20 ? r.PreviousHash.Substring(0, 20) + "..." : r.PreviousHash ?? "GENESIS")</code></td>
                                <td>
                                    <span class="badge bg-green-100 text-green-800 text-[9px]">
                                        <i class="bi bi-shield-check me-1"></i> @(r.VerificationStatus ?? "VERIFIED")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-gray-500 py-4 text-xs">No bank operation audit blocks recorded for this filter.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

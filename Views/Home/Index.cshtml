@{
    ViewBag.Title = "Executive Overview";
}

<div class="row mb-4">
    <div class="col-lg-12">
        <div class="glass-card p-5 text-white">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
                <div>
                    <h1 class="display-4 fw-bold mt-2">LOOP FLOW</h1>
                    <p class="lead text-light mb-0">B2B Embedded Inventory Finance & Multi-Party Settlement Orchestrator</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="@Url.Action("Index", "Buyer")" class="btn btn-loop btn-lg"><i class="bi bi-play-circle me-1"></i> Launch Live Demo</a>
                </div>
            </div>

            <hr class="border-secondary my-4" />

            <div class="row g-4 text-center">
                <div class="col-md-3">
                    <div class="p-3 rounded bg-dark bg-opacity-75 border border-secondary">
                        <div class="stat-value">KES @string.Format("{0:N0}", ViewBag.TotalGMV)</div>
                        <div class="text-light small fw-bold">Platform GMV Processed</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 rounded bg-dark bg-opacity-75 border border-secondary">
                        <div class="stat-value">KES @string.Format("{0:N0}", ViewBag.TotalLoans)</div>
                        <div class="text-light small fw-bold">LOOP BNPL Loans Disbursed</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 rounded bg-dark bg-opacity-75 border border-secondary">
                        <div class="stat-value">KES @string.Format("{0:N0}", ViewBag.TotalSweeps)</div>
                        <div class="text-light small fw-bold">Automated 30% IPN Repayment Sweeps</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 rounded bg-dark bg-opacity-75 border border-secondary">
                        <div class="stat-value">100%</div>
                        <div class="text-light small fw-bold">Real-Time LOOP API Payouts</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="glass-card p-4 h-100">
            <div class="text-info fs-2 mb-2"><i class="bi bi-shop-window"></i></div>
            <h4 class="fw-bold">1. B2B BNPL & Financing Requests</h4>
            <p class="text-light small">Buyers select goods from multiple suppliers. If credit limit is insufficient, they generate a real-time "Financing Request" sent directly to suppliers' dashboards.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="glass-card p-4 h-100">
            <div class="text-success fs-2 mb-2"><i class="bi bi-arrow-split"></i></div>
            <h4 class="fw-bold">2. Instant Multi-Supplier Split Payout</h4>
            <p class="text-light small">Upon supplier approval, LOOP FLOW triggers loan disbursement and automatically splits payouts to all suppliers in milliseconds via LOOP's <code>Send Money API</code>.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="glass-card p-4 h-100">
            <div class="text-warning fs-2 mb-2"><i class="bi bi-cpu"></i></div>
            <h4 class="fw-bold">3. Intelligent 30% Daily Sales Sweep</h4>
            <p class="text-light small">Every daily incoming sales transaction triggers a LOOP IPN webhook. LOOP FLOW automatically sweeps 30% of sales to repay the loan without manual effort.</p>
        </div>
    </div>
</div>
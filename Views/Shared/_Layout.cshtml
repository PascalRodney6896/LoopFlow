<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
    <title>@ViewBag.Title - LOOP FLOW | B2B Embedded Finance</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/Content/site.css" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <!-- Top Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom fixed-top" style="box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
            <div class="container-fluid px-3 px-md-4">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="@Url.Action("Index", "Home")" style="color: #ff5f00;">
                    <i class="bi bi-arrow-repeat fs-5"></i>
                    <span style="font-family: 'Century Gothic', sans-serif; font-weight: 800; font-size: 1.1rem;">LOOP FLOW</span>
                    <span class="text-muted d-none d-md-inline" style="font-size: 0.75rem; font-weight: 400;">| B2B Settlement Engine</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" style="padding: 6px 10px;">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1 gap-md-2 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="@Url.Action("Index", "Home")" style="font-size: 0.85rem; font-weight: 500;">
                                <i class="bi bi-lightning-charge me-1" style="color: #ff5f00;"></i> Overview
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="@Url.Action("Index", "Buyer")" style="font-size: 0.85rem; font-weight: 500;">
                                <i class="bi bi-wallet2 me-1" style="color: #ff5f00;"></i> Buyer Portal
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="@Url.Action("Index", "Supplier")" style="font-size: 0.85rem; font-weight: 500;">
                                <i class="bi bi-shop me-1" style="color: #ff5f00;"></i> Supplier Portal
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="@Url.Action("Index", "Financier")" style="font-size: 0.85rem; font-weight: 500;">
                                <i class="bi bi-bank me-1" style="color: #ff5f00;"></i> LOOP Bank
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="@Url.Action("TrustChain", "Financier")" style="font-size: 0.85rem; font-weight: 500;">
                                <i class="bi bi-shield-check me-1" style="color: #ff5f00;"></i> TrustChain
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="text-muted small me-1 d-none d-sm-inline">Role:</span>
                        <a href="@Url.Action("SwitchRole", "Account", new { role = "Buyer" })" class="role-btn" style="font-size: 0.75rem;">Buyer</a>
                        <a href="@Url.Action("SwitchRole", "Account", new { role = "Supplier" })" class="role-btn" style="font-size: 0.75rem;">Supplier</a>
                        <a href="@Url.Action("SwitchRole", "Account", new { role = "Financier" })" class="role-btn" style="font-size: 0.75rem;">Bank</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main" class="container-fluid px-3 px-md-4" style="margin-top: 70px; padding-bottom: 80px; background: #ffffff; min-height: 100vh;">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert" style="background: #f0fdf4; color: #166534; border-left: 4px solid #22c55e;">
                <i class="bi bi-check-circle-fill me-2" style="color: #22c55e;"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show border-0 shadow-sm" role="alert" style="background: #eff6ff; color: #1e40af; border-left: 4px solid #3b82f6;">
                <i class="bi bi-info-circle-fill me-2" style="color: #3b82f6;"></i> @TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/Custom/buyer-dashboard.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
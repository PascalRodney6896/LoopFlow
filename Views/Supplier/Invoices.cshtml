@model System.Collections.Generic.List<LoopFlow.Models.SupplierInvoice>
@{
    ViewBag.Title = "Supplier Invoice Management";
    Layout = "~/Views/Shared/_Layout_Supplier.cshtml";

    var activeSupplier = ViewBag.ActiveSupplier as LoopFlow.Models.Supplier;
    var eligibleOrders = ViewBag.EligibleOrders as System.Collections.Generic.List<LoopFlow.Models.PurchaseOrder> ?? new System.Collections.Generic.List<LoopFlow.Models.PurchaseOrder>();
}

<div class="px-2 py-1">
    <div class="flex items-center justify-between mb-3">
        <div>
            <h1 class="text-base font-bold text-gray-900">Invoice Management</h1>
            <p class="text-xs text-gray-500">
                Create, upload, and track commercial invoices against purchase orders. Includes automated duplicate-invoice protection & TrustChain verification.
            </p>
        </div>
        <button class="btn btn-sm btn-dark text-xs flex items-center gap-1" data-bs-toggle="modal" data-bs-target="#createInvoiceModal">
            <i class="bi bi-plus-lg"></i> Create / Upload Invoice
        </button>
    </div>

    <!-- Search and Filter Bar -->
    <div class="bg-white p-3 rounded-xl border border-gray-100 shadow-sm mb-3">
        <form method="get" action="@Url.Action("Invoices", "Supplier")" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control bg-light border-start-0 text-xs" placeholder="Search invoice #, order #, merchant..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="status" class="form-select form-select-sm bg-light text-xs">
                    <option value="">All Invoice Statuses</option>
                    <option value="PENDING_VERIFICATION" @(ViewBag.SelectedStatus == "PENDING_VERIFICATION" ? "selected" : "")>Pending Verification</option>
                    <option value="VERIFIED" @(ViewBag.SelectedStatus == "VERIFIED" ? "selected" : "")>Verified</option>
                    <option value="REJECTED" @(ViewBag.SelectedStatus == "REJECTED" ? "selected" : "")>Rejected</option>
                    <option value="PAID" @(ViewBag.SelectedStatus == "PAID" ? "selected" : "")>Paid</option>
                </select>
            </div>
            <div class="col-md-3 flex gap-1">
                <button type="submit" class="btn btn-sm btn-dark text-xs flex-1"><i class="bi bi-filter"></i> Filter</button>
                <a href="@Url.Action("Invoices", "Supplier")" class="btn btn-sm btn-outline-secondary text-xs">Reset</a>
            </div>
        </form>
    </div>

    <!-- Duplicate Protection Alert Banner -->
    <div class="p-3 bg-amber-50 rounded-xl border border-amber-200 mb-3 text-xs flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-amber-200 text-amber-800 flex items-center justify-center flex-shrink-0 text-base">
            <i class="bi bi-shield-exclamation"></i>
        </div>
        <div>
            <span class="font-bold text-amber-900">4. Duplicate-Invoice Protection Active:</span>
            <p class="text-amber-800 my-0">An invoice will be automatically blocked from financing/payment processing if identified as a duplicate or failing mandatory cryptographic verification.</p>
        </div>
    </div>

    <!-- Invoices Table -->
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-receipt text-gray-300 text-4xl block mb-2"></i>
                <p class="text-xs font-semibold text-gray-600">No invoices submitted yet</p>
                <span class="text-[10px] text-gray-400">Click "Create / Upload Invoice" to issue a new commercial invoice against an order.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-xs">
                    <thead class="table-light text-[10px] text-gray-500 uppercase tracking-wider">
                        <tr>
                            <th>Invoice Number</th>
                            <th>Purchase Order #</th>
                            <th>Merchant</th>
                            <th>Amount (KES)</th>
                            <th>Invoice Date</th>
                            <th>Due Date</th>
                            <th>Verification Status</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model)
                        {
                            <tr>
                                <td class="font-bold text-gray-900 font-mono">@inv.InvoiceNumber</td>
                                <td>
                                    <a href="@Url.Action("OrderDetails", "Supplier", new { id = inv.OrderId })" class="text-gray-800 hover:text-[#ff5f00] font-semibold">
                                        #@(inv.Order?.OrderNumber)
                                    </a>
                                </td>
                                <td>@(inv.Order?.Buyer?.User?.FullName ?? "Merchant")</td>
                                <td class="font-bold text-gray-900">KES @string.Format("{0:N2}", inv.Amount)</td>
                                <td class="text-gray-500">@inv.InvoiceDate.ToString("dd MMM yyyy")</td>
                                <td class="text-gray-500">@(inv.DueDate.HasValue ? inv.DueDate.Value.ToString("dd MMM yyyy") : "-")</td>
                                <td>
                                    @if (inv.VerificationStatus == "VERIFIED")
                                    {
                                        <span class="badge bg-green-100 text-green-800 text-[9px] px-2 py-1"><i class="bi bi-check-circle me-1"></i> VERIFIED (Unique)</span>
                                    }
                                    else if (inv.VerificationStatus == "REJECTED")
                                    {
                                        <span class="badge bg-red-100 text-red-800 text-[9px] px-2 py-1"><i class="bi bi-x-circle me-1"></i> REJECTED</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-amber-100 text-amber-800 text-[9px] px-2 py-1"><i class="bi bi-clock me-1"></i> PENDING VERIFICATION</span>
                                    }
                                </td>
                                <td>
                                    @if (inv.Status == "PAID")
                                    {
                                        <span class="badge bg-green-600 text-white text-[9px]">PAID</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-[9px]">@inv.Status</span>
                                    }
                                </td>
                                <td>
                                    <div class="flex items-center gap-1">
                                        @if (inv.Status == "REJECTED" || inv.VerificationStatus == "REJECTED")
                                        {
                                            <button class="btn btn-sm btn-warning text-[10px] py-1 px-2" data-bs-toggle="modal" data-bs-target="#resubmitModal-@inv.Id">
                                                Resubmit
                                            </button>
                                        }
                                        <a href="@Url.Action("Payments", "Supplier", new { search = inv.InvoiceNumber })" class="btn btn-sm btn-outline-dark text-[10px] py-1 px-2">
                                            Payment <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </div>

                                    <!-- Resubmit Modal -->
                                    <div class="modal fade" id="resubmitModal-@inv.Id" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content text-left">
                                                @using (Html.BeginForm("ResubmitInvoice", "Supplier", FormMethod.Post))
                                                {
                                                    <input type="hidden" name="invoiceId" value="@inv.Id" />
                                                    <div class="modal-header py-2 bg-warning-subtle">
                                                        <h6 class="modal-title font-bold text-xs">Correct & Resubmit Invoice</h6>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body text-xs space-y-2">
                                                        <div class="p-2 bg-red-50 border border-red-200 text-red-800 rounded">
                                                            <strong>Rejection Reason:</strong> @(inv.RejectionReason ?? "Verification check failed")
                                                        </div>
                                                        <div>
                                                            <label class="font-bold text-gray-700">Corrected Invoice Number:</label>
                                                            <input type="text" name="newInvoiceNumber" value="@inv.InvoiceNumber" class="form-control text-xs" required />
                                                        </div>
                                                        <div>
                                                            <label class="font-bold text-gray-700">Corrected Amount (KES):</label>
                                                            <input type="number" step="0.01" name="newAmount" value="@inv.Amount" class="form-control text-xs" required />
                                                        </div>
                                                        <div>
                                                            <label class="font-bold text-gray-700">Correction Notes:</label>
                                                            <textarea name="notes" rows="2" class="form-control text-xs" placeholder="Describe corrections made..."></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer py-1.5 bg-light">
                                                        <button type="button" class="btn btn-sm btn-secondary text-xs" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-sm btn-warning text-xs">Resubmit Invoice</button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- CREATE INVOICE MODAL -->
<div class="modal fade" id="createInvoiceModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            @using (Html.BeginForm("CreateInvoice", "Supplier", FormMethod.Post))
            {
                <div class="modal-header py-2 bg-dark text-white">
                    <h6 class="modal-title font-bold text-xs">Create / Upload Commercial Invoice</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-xs space-y-3">
                    <div>
                        <label class="font-bold text-gray-700">Select Purchase Order:</label>
                        <select name="orderId" class="form-select form-select-sm text-xs" required>
                            <option value="">-- Choose Order --</option>
                            @foreach (var po in eligibleOrders)
                            {
                                <option value="@po.Id">Order #@po.OrderNumber — @(po.Buyer?.User?.FullName) (Total KES @po.TotalAmount.ToString("N0"))</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="font-bold text-gray-700">Invoice Number:</label>
                        <input type="text" name="invoiceNumber" class="form-control form-control-sm text-xs" placeholder="e.g. INV-KS-2026-003" required />
                        <span class="text-[9px] text-gray-400">Must be a unique invoice reference.</span>
                    </div>

                    <div>
                        <label class="font-bold text-gray-700">Invoice Amount (KES):</label>
                        <input type="number" step="0.01" name="amount" class="form-control form-control-sm text-xs" placeholder="e.g. 300000.00" required />
                    </div>

                    <div>
                        <label class="font-bold text-gray-700">Payment Due Date:</label>
                        <input type="date" name="dueDate" class="form-control form-control-sm text-xs" />
                    </div>

                    <div>
                        <label class="font-bold text-gray-700">Invoice Notes / Line Items:</label>
                        <textarea name="notes" rows="2" class="form-control text-xs" placeholder="Enter invoice details, goods descriptions, or delivery terms..."></textarea>
                    </div>

                    <div class="alert alert-warning text-[10px] py-1.5 px-2 mb-0">
                        <i class="bi bi-shield-lock me-1"></i> System will generate a cryptographic hash and check for duplicate invoice numbers before allowing processing.
                    </div>
                </div>
                <div class="modal-footer py-1.5 bg-light">
                    <button type="button" class="btn btn-sm btn-secondary text-xs" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-dark text-xs">Submit & Verify Invoice</button>
                </div>
            }
        </div>
    </div>
</div>

@model System.Collections.Generic.List<LoopFlow.Models.Notification>
@{
    ViewBag.Title = "Supplier Notifications";
    Layout = "~/Views/Shared/_Layout_Supplier.cshtml";
}

<div class="px-2 py-1 space-y-3">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-base font-bold text-gray-900">Supplier Notification Hub</h1>
            <p class="text-xs text-gray-500">
                Real-time alerts for new purchase orders, verification requests, invoice status updates, payouts, and delivery reminders.
            </p>
        </div>
        <div>
            <span class="badge bg-red-100 text-red-800 font-bold text-[10px] px-2.5 py-1">
                @Model.Count(n => !n.IsRead) Unread Alert(s)
            </span>
        </div>
    </div>

    <!-- 9. NOTIFICATIONS LIST -->
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-3">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-bell-slash text-gray-300 text-4xl block mb-2"></i>
                <p class="text-xs font-semibold text-gray-600">No notifications</p>
                <span class="text-[10px] text-gray-400">All alerts and workflow events will be delivered here.</span>
            </div>
        }
        else
        {
            <div class="space-y-2">
                @foreach (var n in Model)
                {
                    <div class="p-3 rounded-xl border transition-all flex items-start justify-between gap-3 @(n.IsRead ? "bg-white border-gray-100" : "bg-orange-50/50 border-orange-200")">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm flex-shrink-0 @(n.Priority == "High" ? "bg-red-100 text-red-600" : "bg-orange-100 text-[#ff5f00]")">
                                @if (n.Type == "Invoice verified" || n.Type == "Supplier payment completed")
                                {
                                    <i class="bi bi-check-circle"></i>
                                }
                                else if (n.Type == "Invoice rejected" || n.Type == "Payment failed")
                                {
                                    <i class="bi bi-x-circle"></i>
                                }
                                else
                                {
                                    <i class="bi bi-bell"></i>
                                }
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <h6 class="font-bold text-xs text-gray-900 margin-0">@n.Title</h6>
                                    <span class="badge bg-light text-dark text-[8px] font-mono">@n.Type</span>
                                </div>
                                <p class="text-xs text-gray-600 my-0.5">@n.Message</p>
                                <span class="text-[9px] text-gray-400">@n.SentAt.ToString("dd MMM yyyy, HH:mm")</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2 flex-shrink-0">
                            @if (!string.IsNullOrEmpty(n.Link))
                            {
                                <a href="@n.Link" class="btn btn-sm btn-outline-dark text-[10px] py-1 px-2">View Link</a>
                            }
                            @if (!n.IsRead)
                            {
                                <button onclick="markRead(@n.Id, this)" class="btn btn-sm btn-light text-[10px] py-1 px-2">Mark Read</button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        function markRead(id, btn) {
            $.post('@Url.Action("MarkNotificationRead", "Supplier")', { id: id }, function (res) {
                if (res.success) {
                    $(btn).closest('.rounded-xl').removeClass('bg-orange-50/50 border-orange-200').addClass('bg-white border-gray-100');
                    $(btn).remove();
                }
            });
        }
    </script>
}
